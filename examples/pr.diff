+++ b/test/limits.test.mjs
@@ -0,0 +1,10 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { limitFor } from '../src/limits.mjs';
+
+test('free plan gets 100', () => assert.equal(limitFor('free'), 100));
+test('pro plan gets 5000', () => assert.equal(limitFor('pro'), 5000));
+test('unknown plan falls back to free', () => assert.equal(limitFor('x'), 100));
+test('missing plan falls back to free', () => assert.equal(limitFor(), 100));
+
+// end
